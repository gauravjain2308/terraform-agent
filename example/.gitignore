# ═══════════════════════════════════════════════════════════════════
# terraform/.gitignore
# Applies to all files inside the terraform/ subfolder.
# This is the only folder committed to git.
# ═══════════════════════════════════════════════════════════════════

# ─── Terraform working directory ─────────────────────────────────────
# Downloaded providers and modules — regenerated by terraform init
**/.terraform/
**/.terraform.lock.hcl.backup

# ─── State files — NEVER commit ──────────────────────────────────────
# State contains sensitive data and must live in remote backend (S3)
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
terraform.tfstate.d/

# ─── Variable files — NEVER commit real values ───────────────────────
# *.tfvars files contain environment-specific values including secrets
*.tfvars

# Allow the example templates — these are safe to commit
!*.tfvars.example

# ─── Plan files ──────────────────────────────────────────────────────
# Saved plan files — contain a snapshot of proposed changes
tf.plan
destroy.plan
tf-cost.plan
*.tfplan

# ─── Crash logs ──────────────────────────────────────────────────────
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ─── Generated deployment packages ───────────────────────────────────
# Lambda zip files — these are built by CI/CD, not stored in git
*.zip
placeholder.zip
/tmp/

# ─── OS and editor files ─────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
*.swp
*.swo
*~

# ─── IDE ─────────────────────────────────────────────────────────────
.idea/
*.iml
*.iws
.project
.classpath

# ─── CI/CD secrets ───────────────────────────────────────────────────
# These should never be in the repo regardless
.env
.env.*
!.env.example
secrets.auto.tfvars
sensitive.tfvars

# ─── infracost ───────────────────────────────────────────────────────
.infracost/
infracost-usage.yml

# ─── tflint ──────────────────────────────────────────────────────────
.tflint/

# ─── checkov ─────────────────────────────────────────────────────────
.checkov/
checkov_output/
