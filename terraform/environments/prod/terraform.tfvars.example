# Copy to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

project_name = "s3-presigned-url-upload"
environment  = "prod"
region       = "us-east-1"
aws_profile  = "s3-presigned-url-upload-prod"   # your AWS CLI profile name

# ── upload-bucket (S3 Bucket — Wave 1) ────────────────────────────────────
# Generated by /BuildPlanConfirm wave:1 on 2026-04-21

bucket_name_suffix = "uploads"
# Final name: s3-presigned-url-upload-prod-uploads

force_destroy = false

versioning_status = "Enabled"

encryption_algorithm = "AES256"
# kms_key_arn        = ""   # required only when encryption_algorithm = "aws:kms"
bucket_key_enabled = true

block_public_acls       = true
block_public_policy     = true
ignore_public_acls      = true
restrict_public_buckets = true

cors_enabled         = true
cors_allowed_origins = ["*"]   # TODO: restrict to your production domain before go-live
cors_allowed_methods = ["GET", "PUT", "POST"]
cors_allowed_headers = ["*"]
cors_expose_headers  = ["ETag", "x-amz-request-id"]
cors_max_age_seconds = 3000

lifecycle_enabled                  = true
transition_to_ia_days              = 90
transition_to_glacier_days         = 365
noncurrent_version_expiration_days = 30
object_expiration_days             = 0
lifecycle_prefix                   = ""

access_logging_enabled = false
# access_log_target_bucket = ""   # required only when access_logging_enabled = true
access_log_prefix = "upload-bucket-access-logs/"

object_lock_enabled           = false
transfer_acceleration_enabled = false
intelligent_tiering_enabled   = false
event_notifications_enabled   = false

extra_tags = {
  CostCenter = "engineering"
  DataClass  = "internal"
  Tier       = "storage"
}

permission_boundary_arn = ""
iam_path                = "/"

# ── presigned-url-fn (Lambda Function — Wave 2) ────────────────────────────
# Generated by /BuildPlanConfirm wave:2 on 2026-04-21

function_name_suffix = "presigned-url-fn"
# Final name: s3-presigned-url-upload-prod-presigned-url-fn

runtime      = "python3.12"
handler      = "index.handler"
architecture = "arm64"

package_type     = "zip"
source_code_path = "lambda/presigned-url-fn"

memory_size          = 256
timeout              = 30
ephemeral_storage_mb = 512

reserved_concurrency           = -1
provisioned_concurrency        = 0

lambda_env_vars = {
  PRESIGNED_URL_EXPIRY_SECONDS = "3600"
  MAX_UPLOAD_SIZE_BYTES        = "104857600"
  LOG_LEVEL                    = "WARNING"
  PRESIGNED_URL_METHOD         = "PUT"
  ALLOWED_CONTENT_TYPES        = ""
}

vpc_enabled          = false
function_url_enabled = false
layers               = []
powertools_enabled   = false
dlq_enabled          = false
destinations_enabled = false

log_retention_days = 30
xray_tracing_mode  = "PassThrough"
insights_enabled   = false

lambda_extra_tags = {
  CostCenter = "engineering"
  DataClass  = "internal"
  Tier       = "compute"
}

lambda_permission_boundary_arn = ""
lambda_iam_path                = "/"

# ── api-gateway (API Gateway HTTP v2 — Wave 3) ─────────────────────────────
# Generated by /BuildPlanConfirm wave:3 on 2026-04-21

api_name_suffix = "api"
# Final name: s3-presigned-url-upload-prod-api

api_description  = "Presigned URL API for mobile direct S3 uploads"
protocol_type    = "HTTP"

route_method             = "GET"
route_path               = "/presigned-url"
integration_type         = "AWS_PROXY"
payload_format_version   = "2.0"
integration_timeout_ms   = 10000

stage_name  = "prod"
auto_deploy = true

throttling_burst_limit = 500
throttling_rate_limit  = 200

cors_enabled         = true
cors_allow_origins   = ["*"]   # TODO: replace with your mobile app origin before go-live
cors_allow_methods   = ["GET", "OPTIONS"]
cors_allow_headers   = ["Content-Type", "Authorization", "X-Requested-With"]
cors_expose_headers  = ["X-Request-Id"]
cors_max_age_seconds = 3600

authorization_type = "NONE"

access_logging_enabled = true
# log_group_arn        = ""   # pre-create or let Terraform create the group
log_retention_days   = 30
access_log_format    = "JSON"

custom_domain_enabled = false
mtls_enabled          = false
waf_enabled           = false

detailed_metrics_enabled = true
alarm_4xx_threshold      = 0
alarm_5xx_threshold      = 0
alarm_p99_latency_ms     = 0

apigw_extra_tags = {
  CostCenter = "engineering"
  DataClass  = "internal"
  Tier       = "api"
}

apigw_permission_boundary_arn = ""
apigw_iam_path                = "/"
