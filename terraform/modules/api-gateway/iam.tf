# Module: api-gateway
# IAM — inline policies and resource-based policies
# Generated by iam-generator.py

data "aws_caller_identity" "current" {}
data "aws_region" "current" {}

# Invoke Lambda function
data "aws_iam_policy_document" "inline_api_gateway_presigned_url_fn" {
  statement {
    sid     = "AllowPresignedUrlFn"
    effect  = "Allow"
    actions = [
    "lambda:InvokeFunction"
]
    resources = ["arn:aws:lambda:us-east-1:${data.aws_caller_identity.current.account_id}:function:s3-presigned-url-upload-${var.environment}-presigned-url-fn"]
  }
}

resource "aws_iam_role_policy" "inline_api_gateway_presigned_url_fn" {
  name   = "${var.project_name}-${var.environment}-api-gateway-presigned-url-fn"
  role   = var.api_gateway_name
  policy = data.aws_iam_policy_document.inline_api_gateway_presigned_url_fn.json
}

