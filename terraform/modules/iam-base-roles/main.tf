# Module: iam-base-roles
# Wave 1 — Shared IAM roles consumed by all later waves
# Generated by iam-generator.py

data "aws_caller_identity" "current" {}
data "aws_partition" "current" {}

locals {
  resource_prefix = "${var.project_name}-${var.environment}"
  common_tags = merge(var.tags, {
    Project = var.project_name
    Environment = var.environment
    ManagedBy = "terraform"
    Module = "iam-base-roles"
  })
}

# ── lambda_execution ── Shared execution role for all Lambda functions
data "aws_iam_policy_document" "lambda_execution_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals { type = "Service" identifiers = ["lambda.amazonaws.com"] }
  }
}
resource "aws_iam_role" "lambda_execution" {
  name                 = "${local.resource_prefix}-lambda-execution"
  assume_role_policy   = data.aws_iam_policy_document.lambda_execution_trust.json
  description          = "Shared execution role for all Lambda functions"
  path = var.iam_path
  permissions_boundary = var.permission_boundary_arn != "" ? var.permission_boundary_arn : null
  tags = local.common_tags
}

resource "aws_iam_role_policy_attachment" "lambda_execution_lambdabasicexecutionrole" {
  role       = aws_iam_role.lambda_execution.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy_attachment" "lambda_execution_awsxraydaemonwriteaccess" {
  role       = aws_iam_role.lambda_execution.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/AWSXRayDaemonWriteAccess"
}

resource "aws_iam_role_policy_attachment" "lambda_execution_vpc" {
  count      = var.lambda_vpc_enabled ? 1 : 0
  role       = aws_iam_role.lambda_execution.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/AWSLambdaVPCAccessExecutionRole"
}

# ── apigw_cloudwatch ── API Gateway CloudWatch logging role
data "aws_iam_policy_document" "apigw_cloudwatch_trust" {
  statement {
    effect  = "Allow"
    actions = ["sts:AssumeRole"]
    principals { type = "Service" identifiers = ["apigateway.amazonaws.com"] }
  }
}
resource "aws_iam_role" "apigw_cloudwatch" {
  name                 = "${local.resource_prefix}-apigw-cloudwatch"
  assume_role_policy   = data.aws_iam_policy_document.apigw_cloudwatch_trust.json
  description          = "API Gateway CloudWatch logging role"
  path = var.iam_path
  permissions_boundary = var.permission_boundary_arn != "" ? var.permission_boundary_arn : null
  tags = local.common_tags
}

resource "aws_iam_role_policy_attachment" "apigw_cloudwatch_amazonapigatewaypushtocloudwatchlogs" {
  role       = aws_iam_role.apigw_cloudwatch.name
  policy_arn = "arn:${data.aws_partition.current.partition}:iam::aws:policy/AmazonAPIGatewayPushToCloudWatchLogs"
}

