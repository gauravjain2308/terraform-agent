# Template: Lambda Function Module
# Copy this as a starting point and customize per service.
# Replace all {placeholders} before using.

# ─── versions.tf ─────────────────────────────────────────────
# Child module: required_providers ONLY — no required_version here (root module sets that)

terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    archive = {
      source  = "hashicorp/archive"
      version = "~> 2.4"
    }
  }
}

# ─── variables.tf ────────────────────────────────────────────

variable "project_name" {
  description = "Name of the project. Used in resource naming and tagging."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{2,28}[a-z0-9]$", var.project_name))
    error_message = "project_name must be 4-30 chars, lowercase alphanumeric and hyphens."
  }
}

variable "environment" {
  description = "Deployment environment."
  type        = string

  validation {
    condition     = contains(["dev", "staging", "prod"], var.environment)
    error_message = "environment must be one of: dev, staging, prod."
  }
}

variable "region" {
  description = "AWS region."
  type        = string
  default     = "us-east-1"
}

variable "execution_role_arn" {
  description = "ARN of the IAM role for Lambda execution."
  type        = string
}

variable "execution_role_name" {
  description = "Name of the IAM role for Lambda execution (used for policy attachments)."
  type        = string
  # Pass the role name explicitly — never parse it from the ARN with split()
}

variable "runtime" {
  description = "Lambda runtime identifier."
  type        = string
  default     = "python3.12"
}

variable "handler" {
  description = "Lambda handler (file.function)."
  type        = string
  default     = "handler.lambda_handler"
}

variable "memory_size" {
  description = "Memory allocated to the Lambda function in MB."
  type        = number
  default     = 256

  validation {
    condition     = var.memory_size >= 128 && var.memory_size <= 10240
    error_message = "memory_size must be between 128 and 10240 MB."
  }
}

variable "timeout" {
  description = "Lambda timeout in seconds."
  type        = number
  default     = 30
}

variable "architecture" {
  description = "Instruction set architecture. arm64 is cheaper and faster for most workloads."
  type        = string
  default     = "arm64"

  validation {
    condition     = contains(["x86_64", "arm64"], var.architecture)
    error_message = "architecture must be x86_64 or arm64."
  }
}

variable "tracing_mode" {
  description = "X-Ray tracing mode."
  type        = string
  default     = "Active"

  validation {
    condition     = contains(["Active", "PassThrough"], var.tracing_mode)
    error_message = "tracing_mode must be Active or PassThrough."
  }
}

variable "log_retention_days" {
  description = "CloudWatch log retention period in days."
  type        = number
  default     = 14
}

variable "environment_variables" {
  description = "Environment variables for the Lambda function. Do not put secrets here — use Secrets Manager refs."
  type        = map(string)
  default     = {}
  sensitive   = true
}

# VPC configuration — optional, set to enable VPC attachment
variable "vpc_enabled" {
  description = "Whether to attach the Lambda function to a VPC."
  type        = bool
  default     = false
}

variable "vpc_subnet_ids" {
  description = "Subnet IDs for VPC-attached Lambda. Required when vpc_enabled = true."
  type        = list(string)
  default     = []
}

variable "vpc_security_group_ids" {
  description = "Security group IDs for VPC-attached Lambda. Required when vpc_enabled = true."
  type        = list(string)
  default     = []
}

variable "tags" {
  description = "Additional resource tags."
  type        = map(string)
  default     = {}
}

# ─── main.tf ────────────────────────────────────────────────

locals {
  resource_prefix = "${var.project_name}-${var.environment}"
  function_name   = "${local.resource_prefix}-{service-name}"

  common_tags = merge(var.tags, {
    Project     = var.project_name
    Environment = var.environment
    ManagedBy   = "terraform"
    Module      = "{service-name}"
  })
}

data "aws_region" "current" {}
data "aws_caller_identity" "current" {}

# Placeholder zip written to /tmp — never write into the module source directory
# In production, replace with S3 source or container image
data "archive_file" "lambda_placeholder" {
  type        = "zip"
  output_path = "/tmp/${local.function_name}-placeholder.zip"

  source {
    content  = "# placeholder — replace with real deployment package"
    filename = "handler.py"
  }
}

resource "aws_lambda_function" "main" {
  function_name = local.function_name
  role          = var.execution_role_arn
  runtime       = var.runtime
  handler       = var.handler
  memory_size   = var.memory_size
  timeout       = var.timeout
  architectures = [var.architecture]

  filename         = data.archive_file.lambda_placeholder.output_path
  source_code_hash = data.archive_file.lambda_placeholder.output_base64sha256

  reserved_concurrent_executions = -1  # set a positive value in prod to cap blast radius

  tracing_config {
    mode = var.tracing_mode
  }

  dynamic "vpc_config" {
    for_each = var.vpc_enabled ? [1] : []
    content {
      subnet_ids         = var.vpc_subnet_ids
      security_group_ids = var.vpc_security_group_ids
    }
  }

  environment {
    variables = var.environment_variables
  }

  # No depends_on needed — Terraform infers ordering from resource references above
  tags = local.common_tags

  lifecycle {
    # Lambda deployment is typically managed by CI/CD — ignore filename changes from Terraform
    ignore_changes = [filename, source_code_hash]
  }
}

resource "aws_cloudwatch_log_group" "main" {
  name              = "/aws/lambda/${local.function_name}"
  retention_in_days = var.log_retention_days

  tags = local.common_tags
}

# Use role name variable directly — never parse ARN with split()
resource "aws_iam_role_policy_attachment" "basic_execution" {
  role       = var.execution_role_name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
}

resource "aws_iam_role_policy_attachment" "vpc_access" {
  count      = var.vpc_enabled ? 1 : 0
  role       = var.execution_role_name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole"
}

resource "aws_iam_role_policy_attachment" "xray" {
  role       = var.execution_role_name
  policy_arn = "arn:aws:iam::aws:policy/AWSXRayDaemonWriteAccess"
}

# ─── outputs.tf ─────────────────────────────────────────────

output "function_arn" {
  description = "ARN of the Lambda function."
  value       = aws_lambda_function.main.arn
}

output "function_name" {
  description = "Name of the Lambda function."
  value       = aws_lambda_function.main.function_name
}

output "invoke_arn" {
  description = "Invoke ARN for use with API Gateway."
  value       = aws_lambda_function.main.invoke_arn
}

output "log_group_name" {
  description = "CloudWatch log group name."
  value       = aws_cloudwatch_log_group.main.name
}

output "log_group_arn" {
  description = "ARN of the CloudWatch log group."
  value       = aws_cloudwatch_log_group.main.arn
}

# ─── tests/main.tftest.hcl ──────────────────────────────────

mock_provider "aws" {
  mock_resource "aws_lambda_function" {
    defaults = {
      arn        = "arn:aws:lambda:us-east-1:123456789012:function:mock-function"
      invoke_arn = "arn:aws:apigateway:us-east-1:lambda:path/2015-03-31/functions/arn:aws:lambda:us-east-1:123456789012:function:mock-function/invocations"
    }
  }
  mock_resource "aws_cloudwatch_log_group" {
    defaults = {
      arn = "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/mock"
    }
  }
  mock_data "aws_region" {
    defaults = { name = "us-east-1" }
  }
  mock_data "aws_caller_identity" {
    defaults = { account_id = "123456789012" }
  }
}

run "plan_succeeds_with_valid_inputs" {
  command = plan

  variables {
    project_name        = "test-project"
    environment         = "dev"
    execution_role_arn  = "arn:aws:iam::123456789012:role/test-role"
    execution_role_name = "test-role"
  }

  assert {
    condition     = aws_lambda_function.main.function_name == "test-project-dev-{service-name}"
    error_message = "Function name should follow naming convention."
  }

  assert {
    condition     = aws_lambda_function.main.tags["ManagedBy"] == "terraform"
    error_message = "ManagedBy tag must be 'terraform'."
  }

  assert {
    condition     = aws_lambda_function.main.tracing_config[0].mode == "Active"
    error_message = "X-Ray tracing should be Active by default."
  }

  assert {
    condition     = aws_lambda_function.main.architectures[0] == "arm64"
    error_message = "Default architecture should be arm64."
  }
}

run "rejects_invalid_environment" {
  command = plan

  variables {
    project_name        = "test-project"
    environment         = "production"
    execution_role_arn  = "arn:aws:iam::123456789012:role/test-role"
    execution_role_name = "test-role"
  }

  expect_failures = [var.environment]
}

run "vpc_config_applied_when_enabled" {
  command = plan

  variables {
    project_name           = "test-project"
    environment            = "dev"
    execution_role_arn     = "arn:aws:iam::123456789012:role/test-role"
    execution_role_name    = "test-role"
    vpc_enabled            = true
    vpc_subnet_ids         = ["subnet-aaa", "subnet-bbb"]
    vpc_security_group_ids = ["sg-ccc"]
  }

  assert {
    condition     = length(aws_lambda_function.main.vpc_config) > 0
    error_message = "vpc_config should be set when vpc_enabled is true."
  }
}


