# Terraform working directories
**/.terraform/

# State files — NEVER commit
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info

# Variable files — NEVER commit real values
*.tfvars
!*.tfvars.example

# Plan files
tf.plan
destroy.plan
tf-cost.plan
*.tfplan

# Crash logs
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf

# Generated deployment packages
*.zip
placeholder.zip

# OS
.DS_Store
Thumbs.db
*.swp

# infracost / tflint cache
.infracost/
.tflint/

# Lock file — ALWAYS commit (do NOT add here)
# .terraform.lock.hcl

# Memory state files — generated per-run, not committed
memory/*.json
memory/scaffold-manifest.json

# Local settings overrides
settings.local.json
